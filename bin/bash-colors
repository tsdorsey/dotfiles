#!/bin/bash
#
#   This file echoes a bunch of color codes to the
#   terminal to demonstrate what's available.  Each
#   line is the color code of one forground color,
#   out of 17 (default + 16 escapes), followed by a
#   test use of that color on all nine background
#   colors (default + 8 escapes).
#

T='gYw' # The test text

declare -a BACKGROUND_COLORS=(
  "47m" # White
  "40m" # Black
  "41m" # Red
  "42m" # Green
  "43m" # Yellow
  "44m" # Blue
  "45m" # Magenta
  "46m" # Cyan
)

declare -a FOREGROUND_COLORS=(
    'm' # Default
  "30m" # Black
  "31m" # Red
  "32m" # Green
  "33m" # Yellow
  "34m" # Blue
  "35m" # Magenta
  "36m" # Cyan
  "37m" # White
)

printf "                     %s    %s    %s    %s    %s    %s    %s    %s    %s\n" "${BACKGROUND_COLORS[@]}"

for FG in "${FOREGROUND_COLORS[@]}"; do
  for B in '' '1;'; do
    fgColor="${B}${FG}"
    printf "%12s \033[%s %s \033[0m" "$fgColor" "$fgColor" "$T"
    for BG in "${BACKGROUND_COLORS[@]}"; do
      printf "  \033[%s\033[%s %s \033[0m" "$fgColor" "$BG" "$T"
    done
    echo
  done
done

for FG in {0..255}; do
  for B in '' '1;'; do
    fgColor="${B}38;5;${FG}m"
    printf "%12s \033[%s %s \033[0m" "$fgColor" "$fgColor" "$T"
    for BG in "${BACKGROUND_COLORS[@]}"; do
      printf "  \033[%s\033[%s %s \033[0m" "$fgColor" "$BG" "$T"
    done
    echo
  done
done


echo

