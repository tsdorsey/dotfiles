#!/bin/bash
#
# sudo apt-get install id3v2 ffmpeg
#
# USAGE:
# cd /book title/
# bash ~/book-to-mp3.sh
# rm *.m4b (you need to manually remove the original in case something goes wrong)
#
#
# EXAMPLE:
#
#   $ ls
#   The Wheel of Time - Book 11 - Knife of Dreams, Part 1.m4b  The Wheel of Time - Book 11 - Knife of Dreams, Part 2.m4b
#   $ ~/book-to-mp3.sh
#   .....
#
#   [OUTPUT]:
#
#   File: Knife of Dreams - Chapter 18 - News for the Dragon.mp3
#   Metadata: ID3v2.3
#   Title: Chapter 18 - News for the Dragon
#   Artist: Robert Jordan
#   Album: Knife of Dreams
#   Track: 23
#   Genre: Audiobooks

#initial track number
trackNumber=1


#assumes ( if there are multiple files Part 01/Part 02) that they are in alphabetical order
for bookFilepath in *.m4b; do
  title=$(echo "$bookFilepath" | cut -d'.' -f1)
  title=${title//\[*\]/} # Remove everything in square brackets
  title=${title//:/ -}  # Replace colons with " -"
  title=${title# }  # Remove leading space
  title=${title% }  # Remove trailing space

  echo "title: $title"

  # Subfolder for chapters
  subfolder="$(pwd)/$title"
  fullMP3Filepath="$subfolder/$title.mp3"
  chapterDataFilepath="$subfolder/tmp.txt"
  mkdir -p "$subfolder"

  # Only convert if the output file doesn't exist
  if [[ ! -f "$fullMP3Filepath" ]]; then
    echo "Converting $bookFilepath to $fullMP3Filepath..."
    ffmpeg -i "$bookFilepath" -acodec libmp3lame -ar 44100 -ab 128k "$fullMP3Filepath"
  else
    echo "File $fullMP3Filepath already exists, skipping conversion"
  fi

  ffmpeg -i "$fullMP3Filepath" 2> "$chapterDataFilepath"

  while read -r first _ _ start _ end; do
    if [[ "${first}" != "Chapter" ]]; then
      continue;
    fi

    read # discard line with Metadata:
    read _ _ chapter
    chapter=$(sed -re ":r;s/\b[0-9]{1,$((1))}\b/0&/g;tr" <<<$chapter)
    chapter=${chapter//:/ -}  # Replace colons with " -"
    chapter_file="${subfolder}/$(printf "%02d" $trackNumber) - ${title} - ${chapter}.mp3"
    echo "chapter_file: $chapter_file"
    if [[ ! -f "$chapter_file" ]]; then
      echo "processing $chapter"
      ffmpeg </dev/null -loglevel error -stats -i "${fullMP3Filepath}" -ss "${start%?}" -to "${end}" -codec:a copy -metadata track="${chapter}" "${chapter_file}"
    else
      echo "skipping existing $chapter"
    fi
    id3v2 --artist "Andrew Peterson" --year 2020 --track "$trackNumber" --album "$title" --song "$chapter" --genre 183 "$chapter_file"
    echo "$title - $chapter"
    trackNumber=$((trackNumber + 1))
  done <"$chapterDataFilepath"

  read -p "Remove temporary files? (y/N): " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    rm "$chapterDataFilepath"
    rm "$fullMP3Filepath"
  fi
done
