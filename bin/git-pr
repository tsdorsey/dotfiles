#!/bin/sh
#
# Opens a PR compare url in the browser

repo=$(git remote get-url origin | sed -E 's/^(git@github\.com:|https:\/\/github\.com\/)([^/]+\/[^/.]+)(\.git)?$/\2/');
branch=$(git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD);
ghUsername=$(git config --get user.github);
open "https://github.com/$repo/compare/$branch?expand=1&quick_pull=1&assignees=$ghUsername";

